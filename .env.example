# Application Config
APP_NAME=TilikAI
APP_ENV=development
DEBUG=True
PORT=8000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Sectors Financial API / MCP
SECTORS_API_KEY=your_sectors_api_key_here
SECTORS_API_BASE_URL=https://api.sectors.app/v1

# PostgreSQL Database (Docker)
POSTGRES_USER=tilik_user
POSTGRES_PASSWORD=tilik_password
POSTGRES_DB=tilik_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tilik_user:tilik_password@db:5432/tilik_db
