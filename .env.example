# Application Config
APP_NAME=Tilik AI Backend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Sectors Financial API v2
SECTORS_API_KEY=your_sectors_api_key_here
SECTORS_API_BASE_URL=https://api.sectors.app

# Slang RAG and ChromaDB
SLANG_CSV_PATH=data/slang_dictionary.csv
CHROMA_PERSIST_DIR=data/chroma_db

# Cache & Redis Settings (Credit Optimization)
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=True
CACHE_TTL_SECONDS=3600
CACHE_MAXSIZE=2000
